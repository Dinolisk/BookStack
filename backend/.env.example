# Port the server listens on
PORT=5001

# PostgreSQL connection string (Session pooler recommended on Windows)
DATABASE_URL=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

# Demo account for recruiters (1-click login)
DEMO_USER_ID=
DEMO_USER_EMAIL=demo@bookstack.com

# Google Books search (free – create at console.cloud.google.com, enable "Books API")
GOOGLE_BOOKS_API_KEY=
